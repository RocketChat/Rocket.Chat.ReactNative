{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"bracketSpacing": true,
	"singleQuote": true,
	"jsxSingleQuote": true,
	"trailingComma": "none",
	"printWidth": 130,
	"useTabs": true,
	"arrowParens": "avoid",
	"bracketSameLine": true,
	"sortPackageJson": false,
	"ignorePatterns": [
		".github/",
		"build/",
		"node_modules/",
		"coverage/",
		"e2e/docker/",
		"artifacts/",
		"android/",
		"ios/",
		"patches/",
		"scripts/",
		".worktrees/",
		".bettercodehub.yml",
		".buckconfig",
		".gitattributes",
		".gitignore",
		".snyk",
		".watchmanconfig",
		"CONTRIBUTING.md",
		"README.md",
		"SECURITY.md",
		"npm-debug.log",
		"yarn-error.log",
		"pnpm-lock.yaml",
		".storybook/",
		"app/i18n/locales/",
		"app/containers/CustomIcon/mappedIcons.js",
		"app/containers/CustomIcon/selection.json",
		"tools/oxlint/anti-slop/"
	]
}
