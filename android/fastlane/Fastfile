# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

platform :android do
  TRACK_BY_TRIGGER = { 'pr' => 'internal', 'develop' => 'beta' }.freeze

  def with_retries(times: 3, sleep_time: 10)
    tries = 0
    begin
      yield
    rescue => e
      tries += 1
      if tries < times
        UI.error("Retrying due to error: #{e}")
        sleep(sleep_time)
        retry
      else
        raise
      end
    end
  end

  desc "Upload App to the Play Store track for TRIGGER (pr: internal, develop: beta)"
  lane :upload do
    upload_to_play_store(
      package_name: 'chat.rocket.android',
      track: TRACK_BY_TRIGGER.fetch(ENV['TRIGGER']),
      aab: 'app/build/outputs/bundle/release/app-release.aab',
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload App to Internal App Sharing"
  lane :internal_app_sharing do
    upload_to_play_store_internal_app_sharing(
      package_name: 'chat.rocket.android',
      aab: 'app/build/outputs/bundle/release/app-release.aab'
    )
  end

  desc "Promote BUILD_VERSION from the internal track to open testing (beta)"
  lane :open_testing do
    upload_to_play_store(
      package_name: 'chat.rocket.android',
      track: TRACK_BY_TRIGGER.fetch('pr'),
      track_promote_to: 'beta',
      version_code: Integer(ENV.fetch('BUILD_VERSION')),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote BUILD_VERSION from the TRIGGER track to Production"
  lane :production do
    version_code = Integer(ENV.fetch('BUILD_VERSION'))
    metadata_path = File.join(__dir__, 'metadata/android')
    changelogs_path = File.join(metadata_path, 'en-US/changelogs')

    FileUtils.mkdir_p(changelogs_path)
    FileUtils.cp(File.expand_path('../../.github/store-release-notes.txt', __dir__), File.join(changelogs_path, "#{version_code}.txt"))

    upload_to_play_store(
      package_name: 'chat.rocket.android',
      track: TRACK_BY_TRIGGER.fetch(ENV['TRIGGER']),
      track_promote_to: 'production',
      version_code: version_code,
      metadata_path: metadata_path,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
