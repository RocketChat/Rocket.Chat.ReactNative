+package com.swmansion.enriched.markdown.utils.text
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.drawable.BitmapDrawable
+import android.graphics.drawable.Drawable
+import android.util.LruCache
+import com.bumptech.glide.Glide
+import com.bumptech.glide.RequestBuilder
+import com.bumptech.glide.load.model.GlideUrl
+import com.bumptech.glide.load.model.LazyHeaders
+import com.bumptech.glide.load.resource.bitmap.DownsampleStrategy
+import com.bumptech.glide.request.target.CustomTarget
+import com.bumptech.glide.request.transition.Transition
+
+object RemoteImageLoader {
+  private const val RECENT_DELIVERIES_BYTES = 20 * 1024 * 1024
+
+  // Glide keeps a delivered image in memory only while its request is referenced, so the
+  // latest deliveries stay referenced here and a new span for the same image draws it at once.
+  private val recentDeliveries =
+    object : LruCache<String, DeliveringTarget<*>>(RECENT_DELIVERIES_BYTES) {
+      override fun sizeOf(
+        key: String,
+        value: DeliveringTarget<*>,
+      ): Int = value.resourceBytes
+    }
+
+  fun loadDrawable(
+    context: Context,
+    url: String,
+    headers: Map<String, String>,
+    fitWithin: Int?,
+    onLoaded: (Drawable?) -> Unit,
+  ) {
+    val request =
+      Glide
+        .with(context.applicationContext)
+        .asDrawable()
+        .withRemoteModel(url, headers)
+    val sizedRequest =
+      if (fitWithin == null) {
+        val screenWidth = context.resources.displayMetrics.widthPixels
+        request.override(screenWidth, screenWidth).downsample(WidthOnlyDownsampleStrategy)
+      } else {
+        request.override(fitWithin, fitWithin).downsample(DownsampleStrategy.CENTER_INSIDE)
+      }
+    sizedRequest.into(DeliveringTarget(deliveryKey("drawable", url, headers, fitWithin), onLoaded))
+  }
+
+  fun loadBitmap(
+    context: Context,
+    url: String,
+    headers: Map<String, String>,
+    maxDimension: Int,
+    onLoaded: (Bitmap?) -> Unit,
+  ) {
+    Glide
+      .with(context.applicationContext)
+      .asBitmap()
+      .withRemoteModel(url, headers)
+      .override(maxDimension, maxDimension)
+      .downsample(DownsampleStrategy.CENTER_INSIDE)
+      .into(DeliveringTarget(deliveryKey("bitmap", url, headers, maxDimension), onLoaded))
+  }
+
+  private fun deliveryKey(
+    resourceType: String,
+    url: String,
+    headers: Map<String, String>,
+    size: Int?,
+  ): String = "$resourceType|${size ?: "screen"}|${ImageCache.requestKey(url, headers)}"
+
+  private fun byteCount(resource: Any): Int =
+    when (resource) {
+      is Bitmap -> resource.allocationByteCount
+      is BitmapDrawable -> resource.bitmap?.allocationByteCount ?: 0
+      is Drawable -> resource.intrinsicWidth * resource.intrinsicHeight * 4
+      else -> 0
+    }.coerceAtLeast(1)
+
+  private fun <ResourceType : Any> RequestBuilder<ResourceType>.withRemoteModel(
+    url: String,
+    headers: Map<String, String>,
+  ): RequestBuilder<ResourceType> {
+    val requestHeaders = LazyHeaders.Builder().apply { headers.forEach { (name, value) -> addHeader(name, value) } }.build()
+    return load(GlideUrl(url, requestHeaders)).disallowHardwareConfig()
+  }
+
+  private object WidthOnlyDownsampleStrategy : DownsampleStrategy() {
+    override fun getScaleFactor(
+      sourceWidth: Int,
+      sourceHeight: Int,
+      requestedWidth: Int,
+      requestedHeight: Int,
+    ): Float = minOf(1f, requestedWidth.toFloat() / sourceWidth)
+
+    override fun getSampleSizeRounding(
+      sourceWidth: Int,
+      sourceHeight: Int,
+      requestedWidth: Int,
+      requestedHeight: Int,
+    ): SampleSizeRounding = SampleSizeRounding.QUALITY
+  }
+
+  private class DeliveringTarget<ResourceType : Any>(
+    private val deliveryKey: String,
+    onLoaded: (ResourceType?) -> Unit,
+  ) : CustomTarget<ResourceType>() {
+    private var onLoaded: ((ResourceType?) -> Unit)? = onLoaded
+
+    var resourceBytes = 1
+      private set
+
+    override fun onResourceReady(
+      resource: ResourceType,
+      transition: Transition<in ResourceType>?,
+    ) {
+      resourceBytes = byteCount(resource)
+      recentDeliveries.put(deliveryKey, this)
+      deliver(resource)
+    }
+
+    override fun onLoadFailed(errorDrawable: Drawable?) = deliver(null)
+
+    override fun onLoadCleared(placeholder: Drawable?) = Unit
+
+    private fun deliver(resource: ResourceType?) {
+      val callback = onLoaded ?: return
+      onLoaded = null
+      callback(resource)
+    }
+  }
+}
