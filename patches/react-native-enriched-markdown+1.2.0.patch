+import androidx.annotation.RequiresApi
+import androidx.core.graphics.drawable.toDrawable
+import java.nio.ByteBuffer
+import java.util.concurrent.Executors
+
+object AnimatedImageDecoder {
+  private const val TAG = "AnimatedImageDecoder"
+
+  private val executor = Executors.newSingleThreadExecutor()
+  private val mainHandler = Handler(Looper.getMainLooper())
+
+  fun decode(
+    image: LoadedImage.Animated,
+    targetWidth: Int,
+    targetHeight: Int,
+    resources: Resources,
+    callback: (Drawable?) -> Unit,
+  ) {
+    executor.execute {
+      val drawable =
+        decodeAnimation(image, targetWidth, targetHeight)
+          ?: decodeStill(image, targetWidth, targetHeight)?.toDrawable(resources)
+      mainHandler.post { callback(drawable) }
+    }
+  }
+
+  fun decodeFirstFrame(
+    image: LoadedImage.Animated,
+    targetWidth: Int,
+    targetHeight: Int,
+    callback: (Bitmap?) -> Unit,
+  ) {
+    executor.execute {
+      val bitmap = decodeStill(image, targetWidth, targetHeight)
+      mainHandler.post { callback(bitmap) }
+    }
+  }
+
+  private fun decodeAnimation(
+    image: LoadedImage.Animated,
+    targetWidth: Int,
+    targetHeight: Int,
+  ): Drawable? {
+    if (Build.VERSION.SDK_INT < Build.VERSION_CODES.P) return null
+    try {
+      return decodeWithImageDecoder(image.encoded, targetWidth, targetHeight)
+    } catch (_: OutOfMemoryError) {
+      Log.e(TAG, "OOM decoding animated image ${targetWidth}x$targetHeight")
+      return null
+    } catch (e: Exception) {
+      Log.e(TAG, "Failed to decode animated image", e)
+      return null
+    }
+  }
+
+  @RequiresApi(Build.VERSION_CODES.P)
+  private fun decodeWithImageDecoder(
+    encoded: ByteArray,
+    targetWidth: Int,
+    targetHeight: Int,
+  ): Drawable =
+    ImageDecoder.decodeDrawable(ImageDecoder.createSource(ByteBuffer.wrap(encoded))) { decoder, _, _ ->
+      decoder.setTargetSize(targetWidth, targetHeight)
+    }
+
+  private fun decodeStill(
+    image: LoadedImage.Animated,
+    targetWidth: Int,
+    targetHeight: Int,
+  ): Bitmap? {
+    val options =
+      BitmapFactory.Options().apply {
+        inSampleSize = sampleSize(image, targetWidth, targetHeight)
+      }
+    try {
+      return BitmapFactory.decodeByteArray(image.encoded, 0, image.encoded.size, options)
+    } catch (_: OutOfMemoryError) {
+      Log.e(TAG, "OOM decoding still image ${targetWidth}x$targetHeight")
+      return null
+    }
+  }
+
+  private fun sampleSize(
+    image: LoadedImage.Animated,
+    targetWidth: Int,
+    targetHeight: Int,
+  ): Int {
+    val downscale = minOf(image.width / targetWidth, image.height / targetHeight)
+    return if (downscale <= 1) 1 else Integer.highestOneBit(downscale)
+  }
+}
