+#import "ENRMLinkLongPressRecognizer.h"
+#import "LinkTapUtils.h"
+
+#if !TARGET_OS_OSX
+
+@interface ENRMLinkLongPressRecognizer () <UIGestureRecognizerDelegate>
+@property (nonatomic, copy) BOOL (^linkPreviewEnabled)(void);
+@property (nonatomic, copy) void (^onLinkLongPress)(NSString *url);
+@end
+
+@implementation ENRMLinkLongPressRecognizer
+
+- (instancetype)initWithLinkPreviewEnabled:(BOOL (^)(void))linkPreviewEnabled
+                           onLinkLongPress:(void (^)(NSString *url))onLinkLongPress
+{
+  if (self = [super initWithTarget:nil action:nil]) {
+    _linkPreviewEnabled = [linkPreviewEnabled copy];
+    _onLinkLongPress = [onLinkLongPress copy];
+    [self addTarget:self action:@selector(handleLongPress)];
+    self.delegate = self;
+  }
+  return self;
+}
+
+- (BOOL)gestureRecognizer:(UIGestureRecognizer *)gestureRecognizer shouldReceiveTouch:(UITouch *)touch
+{
+  ENRMPlatformTextView *textView = (ENRMPlatformTextView *)self.view;
+  if (textView.selectable || self.linkPreviewEnabled()) {
+    return NO;
+  }
+  return linkURLAtPoint(textView, [touch locationInView:textView]) != nil;
+}
+
+- (void)handleLongPress
+{
+  if (self.state != UIGestureRecognizerStateBegan) {
+    return;
+  }
+  ENRMPlatformTextView *textView = (ENRMPlatformTextView *)self.view;
+  NSString *url = linkURLAtPoint(textView, [self locationInView:textView]);
+  if (url) {
+    self.onLinkLongPress(url);
+  }
+}
+
+@end
+
+#endif
