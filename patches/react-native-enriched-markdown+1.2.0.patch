+package com.swmansion.enriched.markdown.utils.text
+
+import android.graphics.ImageDecoder
+import android.graphics.drawable.Drawable
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.util.Log
+import androidx.annotation.RequiresApi
+import java.nio.ByteBuffer
+import java.util.concurrent.Executors
+
+object AnimatedImageDecoder {
+  private const val TAG = "AnimatedImageDecoder"
+
+  private val executor = Executors.newSingleThreadExecutor()
+  private val mainHandler = Handler(Looper.getMainLooper())
+
+  fun decode(
+    encoded: ByteArray,
+    targetWidth: Int,
+    targetHeight: Int,
+    callback: (Drawable?) -> Unit,
+  ) {
+    if (Build.VERSION.SDK_INT < Build.VERSION_CODES.P) {
+      callback(null)
+      return
+    }
+    executor.execute {
+      val drawable = decodeOrNull(encoded, targetWidth, targetHeight)
+      mainHandler.post { callback(drawable) }
+    }
+  }
+
+  @RequiresApi(Build.VERSION_CODES.P)
+  private fun decodeOrNull(
+    encoded: ByteArray,
+    targetWidth: Int,
+    targetHeight: Int,
+  ): Drawable? =
+    try {
+      ImageDecoder.decodeDrawable(ImageDecoder.createSource(ByteBuffer.wrap(encoded))) { decoder, _, _ ->
+        decoder.setTargetSize(targetWidth, targetHeight)
+      }
+    } catch (_: OutOfMemoryError) {
+      Log.e(TAG, "OOM decoding animated image ${targetWidth}x$targetHeight")
+      null
+    } catch (e: Exception) {
+      Log.e(TAG, "Failed to decode animated image", e)
+      null
+    }
+}
