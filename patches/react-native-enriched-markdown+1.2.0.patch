+package com.swmansion.enriched.markdown.spans
+
+import android.graphics.drawable.Animatable
+import android.graphics.drawable.Drawable
+import android.os.Handler
+import android.os.Looper
+import java.util.Collections
+import java.util.WeakHashMap
+
+// Glide hands every request for one image the same drawable when it has no constant state
+// (APNG4Android's drawables), so one span stopping it must not freeze the others.
+internal object SharedAnimationRunner {
+  private val runningOwnersByDrawable = WeakHashMap<Drawable, MutableSet<Any>>()
+
+  private val mainHandler = Handler(Looper.getMainLooper())
+
+  fun attachCallback(
+    drawable: Drawable,
+    callback: Drawable.Callback,
+  ) {
+    if (Looper.myLooper() != Looper.getMainLooper()) {
+      mainHandler.post { attachCallback(drawable, callback) }
+      return
+    }
+    drawable.callback = callback
+    // APNG4Android's FrameAnimationDrawable keeps invalidating every callback it saw in setVisible,
+    // and starts itself there unless autoPlay is off; only owners may keep it running.
+    drawable.setVisible(true, false)
+    val animatable = drawable as? Animatable ?: return
+    if (animatable.isRunning && runningOwnersByDrawable[drawable].isNullOrEmpty()) animatable.stop()
+  }
+
+  fun start(
+    drawable: Drawable,
+    owner: Any,
+  ) {
+    val animatable = drawable as? Animatable ?: return
+    runningOwnersByDrawable.getOrPut(drawable) { Collections.newSetFromMap(WeakHashMap()) }.add(owner)
+    if (!animatable.isRunning) animatable.start()
+  }
+
+  fun stop(
+    drawable: Drawable,
+    owner: Any,
+  ) {
+    val animatable = drawable as? Animatable ?: return
+    val owners = runningOwnersByDrawable[drawable] ?: return
+    owners.remove(owner)
+    if (owners.isNotEmpty()) return
+    runningOwnersByDrawable.remove(drawable)
+    animatable.stop()
+  }
+}
