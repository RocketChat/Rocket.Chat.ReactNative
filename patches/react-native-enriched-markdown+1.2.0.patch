+BOOL ENRMIsAnimatedImage(RCTUIImage *image)
+{
+#if !TARGET_OS_OSX
+  if (![image isKindOfClass:[SDAnimatedImage class]])
+    return NO;
+  SDAnimatedImage *animatedImage = (SDAnimatedImage *)image;
+  SDImageFormat format = animatedImage.animatedImageFormat;
+  return animatedImage.animatedImageFrameCount > 1 &&
+         (format == SDImageFormatGIF || format == SDImageFormatPNG || format == SDImageFormatWebP);
+#else
+  return NO;
+#endif
+}
+
+@interface ENRMRenderedFrameProvider : NSObject <SDAnimatedImageProvider>
+- (instancetype)initWithImage:(id<SDAnimatedImageProvider>)image frameRenderer:(ENRMAnimationFrameRenderer)frameRenderer;
+@end
+
+@implementation ENRMRenderedFrameProvider {
+  id<SDAnimatedImageProvider> _image;
+  ENRMAnimationFrameRenderer _frameRenderer;
+}
+
+- (instancetype)initWithImage:(id<SDAnimatedImageProvider>)image frameRenderer:(ENRMAnimationFrameRenderer)frameRenderer
+{
+  self = [super init];
+  if (self) {
+    _image = image;
+    _frameRenderer = [frameRenderer copy];
+  }
+  return self;
+}
+
+- (NSData *)animatedImageData
+{
+  return _image.animatedImageData;
+}
+
+- (NSUInteger)animatedImageFrameCount
+{
+  return _image.animatedImageFrameCount;
+}
+
+- (NSUInteger)animatedImageLoopCount
+{
+  return _image.animatedImageLoopCount;
+}
+
+- (RCTUIImage *)animatedImageFrameAtIndex:(NSUInteger)index
+{
+  RCTUIImage *frame = [_image animatedImageFrameAtIndex:index];
+  return frame ? _frameRenderer(frame) : nil;
+}
+
+- (NSTimeInterval)animatedImageDurationAtIndex:(NSUInteger)index
+{
+  return [_image animatedImageDurationAtIndex:index];
+}
+
+@end
+
+@implementation ENRMSharedImageAnimation {
+  ENRMRenderedFrameProvider *_frameProvider;
+  SDAnimatedImagePlayer *_player;
+  NSHashTable<id<ENRMAnimatedImageDisplay>> *_displays;
+  BOOL _playedAllLoops;
+}
+
++ (NSMapTable<NSString *, ENRMSharedImageAnimation *> *)animationsByKey
+{
+  static NSMapTable<NSString *, ENRMSharedImageAnimation *> *animations;
+  static dispatch_once_t onceToken;
+  dispatch_once(&onceToken, ^{ animations = [NSMapTable strongToWeakObjectsMapTable]; });
+  return animations;
+}
+
++ (instancetype)animationForImage:(RCTUIImage *)image
+                              key:(NSString *)key
+                    frameRenderer:(ENRMAnimationFrameRenderer)frameRenderer
+{
+  NSMapTable<NSString *, ENRMSharedImageAnimation *> *animations = [self animationsByKey];
+  @synchronized(animations) {
+    ENRMSharedImageAnimation *animation = [animations objectForKey:key];
+    if (!animation) {
+      animation = [[self alloc] initWithImage:image frameRenderer:frameRenderer];
+      [animations setObject:animation forKey:key];
+    }
+    return animation;
+  }
+}
+
+- (instancetype)initWithImage:(RCTUIImage *)image frameRenderer:(ENRMAnimationFrameRenderer)frameRenderer
+{
+  self = [super init];
+  if (self) {
+    _frameProvider = [[ENRMRenderedFrameProvider alloc] initWithImage:(id<SDAnimatedImageProvider>)image
+                                                        frameRenderer:frameRenderer];
+    _displays = [NSHashTable weakObjectsHashTable];
+  }
+  return self;
+}
+
+- (void)dealloc
+{
+  [_player stopPlaying];
+}
+
+- (void)playForDisplay:(id<ENRMAnimatedImageDisplay>)display
+{
+  if (!NSThread.isMainThread) {
+    dispatch_async(dispatch_get_main_queue(), ^{ [self playForDisplay:display]; });
+    return;
+  }
+  [_displays addObject:display];
+  if (_playedAllLoops || _player.isPlaying || [display displayingTextViewsInWindow].count == 0)
+    return;
+  [[self player] startPlaying];
+}
+
+- (void)removeDisplay:(id<ENRMAnimatedImageDisplay>)display
+{
+  if (!NSThread.isMainThread) {
+    dispatch_async(dispatch_get_main_queue(), ^{ [self removeDisplay:display]; });
+    return;
+  }
+  [_displays removeObject:display];
+}
